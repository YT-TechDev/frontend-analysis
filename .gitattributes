# Retained upstream evidence is content-addressed over exact bytes.
# Disable Git EOL normalization and whitespace-error classification only for
# these paths; they remain reviewable as text and must match their frozen blobs.
tools/unicode/inputs/** -text -whitespace
tools/unicode/UNICODE-LICENSE.txt -text -whitespace
tools/unicode/ECMA262-LICENSE.md -text -whitespace
tools/unicode/ECMA262-COPYRIGHT.html -text -whitespace

# Project-authored reproducibility inputs/outputs use canonical LF bytes.
# This keeps manifest hashing, generated-output checks, and executable Python
# entry points independent of core.autocrlf.
tools/unicode/upstream-manifest.json text eol=lf
tools/unicode/generate_ecmascript_unicode.py text eol=lf
tools/unicode/verify_generated_ecmascript_unicode.py text eol=lf
crates/frontend-analysis-core/src/ecmascript/unicode_generated.rs text eol=lf

# WHATWG HTML Named Character Reference evidence is retained byte-for-byte.
tools/html/named_character_references/inputs/entities.json -text -whitespace
tools/html/named_character_references/WHATWG-LICENSE.txt -text -whitespace

# Project-authored HTML Named Character Reference data tooling uses LF bytes.
tools/html/named_character_references/README.md text eol=lf
tools/html/named_character_references/UPSTREAM-LICENSING.md text eol=lf
tools/html/named_character_references/upstream-manifest.json text eol=lf
tools/html/named_character_references/generate_named_character_references.py text eol=lf
tools/html/named_character_references/verify_generated_named_character_references.py text eol=lf
tools/html/named_character_references/tests/test_generate_named_character_references.py text eol=lf
crates/frontend-analysis-core/src/html/tokenizer/named_character_references_generated.rs text eol=lf
crates/frontend-analysis-core/src/html/tokenizer/named_character_references_data_tests.rs text eol=lf
